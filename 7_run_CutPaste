   "source": [
    "##3.改anomaly_detection.py文件\n",
    "from typing import Any, Dict, Tuple, Union\n",
    "from sklearn.neighbors import KernelDensity\n",
    "from sklearn.metrics import roc_curve, auc\n",
    "from sklearn.preprocessing import normalize\n",
    "from sklearn.manifold import TSNE\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.utils import shuffle\n",
    "from model import CutPasteNet\n",
    "from dataset import MVTecAD\n",
    "from torch.utils.data import DataLoader\n",
    "import numpy as np\n",
    "import pickle\n",
    "import torch\n",
    "import os\n",
    "import tqdm\n",
    "import argparse\n",
    "from glob import glob\n",
    "import pathlib\n",
    "\n",
    "def get_args():\n",
    "    parser = argparse.ArgumentParser()\n",
    "    parser.add_argument('--path_to_checkpoints',\n",
    "                        help='data to the folder where results from self-supervised are saved, eg: ./tb_logs')\n",
    "    parser.add_argument('--Data', help='data to MVTec data root.')\n",
    "    parser.add_argument('--batch_size', type=int, default=32)\n",
    "    # 使用 Kaggle 的输出工作目录\n",
    "    parser.add_argument('--save_exp', default='/kaggle/working/anomaly_exp', help='Save fitted models and roc curves')\n",
    "    args = parser.parse_args()\n",
    "    return args\n",
    "\n",
    "class AnomalyDetection:\n",
    "    def __init__(self, weights, batch_size, device='cuda' if torch.cuda.is_available() else 'cpu'):\n",
    "        '''\n",
    "        Anomaly Detection\n",
    "\n",
    "        args:\n",
    "        weights[str] _ path to weights\n",
    "        device[str] _ device on which model should be run\n",
    "        '''\n",
    "        self.cutpaste_model = self.model(device, weights)\n",
    "        self.device = device\n",
    "        self.batch_size = batch_size\n",
    "\n",
    "    @staticmethod\n",
    "    def model(device, weights):\n",
    "        model = CutPasteNet(pretrained=False)\n",
    "        state_dict = torch.load(weights, map_location=device)['state_dict']\n",
    "        # 移除 Lightning 包装产生的 'model.' 前缀\n",
    "        state_dict = {i.replace('model.', ''): j for i, j in state_dict.items()}\n",
    "        model.load_state_dict(state_dict)\n",
    "        model.to(device)\n",
    "        model.eval()\n",
    "        return model\n",
    "\n",
    "    @staticmethod\n",
    "    def roc_auc(labels, scores, defect_name=None, save_path=None):\n",
    "        fpr, tpr, _ = roc_curve(labels, scores)\n",
    "        roc_auc = auc(fpr, tpr)\n",
    "\n",
    "        plt.figure()\n",
    "        plt.title(f'ROC curve: {defect_name}')\n",
    "        plt.plot(fpr, tpr, 'b', label='AUC = %0.2f' % roc_auc)\n",
    "        plt.legend(loc='lower right')\n",
    "        plt.plot([0, 1], [0, 1], 'r--')\n",
    "        plt.xlim([0, 1])\n",
    "        plt.ylim([0, 1])\n",
    "        plt.ylabel('True Positive Rate')\n",
    "        plt.xlabel('False Positive Rate')\n",
    "\n",
    "        save_images = save_path if save_path else './roc_results'\n",
    "        os.makedirs(save_images, exist_ok=True)\n",
    "        image_path = os.path.join(save_images, f'{defect_name}_roc.jpg' if defect_name else 'roc_curve.jpg')\n",
    "        plt.savefig(image_path)\n",
    "        plt.close()\n",
    "        return roc_auc\n",
    "\n",
    "    @staticmethod\n",
    "    def plot_tsne(labels, embeds, defect_name=None, save_path=None, **kwargs: Dict[str, Any]):\n",
    "        \"\"\"t-SNE visualize\"\"\"\n",
    "        \n",
    "        # 适配 Scikit-Learn：新版本要求降维数据必须是标准的 numpy float 数组\n",
    "        embeds_np = embeds.detach().cpu().numpy().astype(np.float32)\n",
    "        labels_np = labels.detach().cpu().numpy().astype(np.int32)\n",
    "\n",
    "        tsne = TSNE(\n",
    "            n_components=2, \n",
    "            verbose=0, \n",
    "            n_iter=kwargs.get(\"n_iter\", 1000),\n",
    "            learning_rate=kwargs.get(\"learning_rate\", 'auto'), # 新版 sklearn 'auto' 是更好的默认值\n",
    "            perplexity=kwargs.get(\"perplexity\", 30), \n",
    "            early_exaggeration=kwargs.get(\"early_exaggeration\", 12),\n",
    "            angle=kwargs.get(\"angle\", 0.5),\n",
    "            init=kwargs.get(\"init\", \"pca\"),\n",
    "        )\n",
    "        \n",
    "        embeds_np, labels_np = shuffle(embeds_np, labels_np)\n",
    "        tsne_results = tsne.fit_transform(embeds_np)\n",
    "\n",
    "        # 适配 Matplotlib 3.x：旧版 plt.cm.get_cmap 已经被废弃\n",
    "        try:\n",
    "            cmap = plt.colormaps['spring']\n",
    "        except (AttributeError, KeyError):\n",
    "            cmap = plt.cm.get_cmap(\"spring\")\n",
    "\n",
    "        colors = np.vstack((np.array([[0.0, 1.0, 0.0, 1.0]]), cmap(np.linspace(0, 1, 3))))\n",
    "        legends = [\"good\", \"anomaly\", \"cutpaste\", \"cutpaste-scar\"]\n",
    "        \n",
    "        fig, ax = plt.subplots(1)\n",
    "        plt.title(f't-SNE: {defect_name}')\n",
    "        \n",
    "        unique_labels = np.unique(labels_np)\n",
    "        for label in unique_labels:\n",
    "            indices = np.where(labels_np == label)\n",
    "            res = tsne_results[indices]\n",
    "            if len(res) > 0:\n",
    "                ax.plot(*res.T, marker=\"*\", linestyle=\"\", ms=5, \n",
    "                        label=legends[label] if label < len(legends) else f\"label_{label}\", \n",
    "                        color=colors[label] if label < len(colors) else 'black')\n",
    "        \n",
    "        ax.legend(loc=\"best\")\n",
    "        plt.xticks([])\n",
    "        plt.yticks([])\n",
    "\n",
    "        save_images = save_path if save_path else './tsne_results'\n",
    "        os.makedirs(save_images, exist_ok=True)\n",
    "        image_path = os.path.join(save_images, f'{defect_name}_tsne.jpg' if defect_name else 'tsne.jpg')\n",
    "        plt.savefig(image_path)\n",
    "        plt.close()\n",
    "\n",
    "    def create_embeds(self, path_to_images):\n",
    "        embeddings = []\n",
    "        labels = []\n",
    "        dataset = MVTecAD(path_to_images, mode='test')\n",
    "        dataloader = DataLoader(dataset, batch_size=self.batch_size, num_workers=2)\n",
    "        \n",
    "        with torch.no_grad():\n",
    "            for imgs, lbls in dataloader:\n",
    "                logits, embeds = self.cutpaste_model(imgs.to(self.device))\n",
    "                del logits\n",
    "                embeddings.append(embeds.to('cpu'))\n",
    "                labels.append(lbls.to('cpu'))\n",
    "                torch.cuda.empty_cache()\n",
    "\n",
    "        return torch.cat(embeddings), torch.cat(labels)\n",
    "    \n",
    "    def create_embeds_tsne(self, path_to_images: Union[str, pathlib.Path]) -> Tuple[torch.Tensor, torch.Tensor]:\n",
    "        embeddings = []\n",
    "        labels = []\n",
    "        dataset = MVTecAD(path_to_images, mode='train')\n",
    "        dataloader = DataLoader(dataset, batch_size=self.batch_size, num_workers=2)\n",
    "        \n",
    "        with torch.no_grad():\n",
    "            for (i_batch, imgs) in enumerate(dataloader):\n",
    "                # 兼容性整理\n",
    "                if isinstance(imgs, list):\n",
    "                    imgs = torch.cat(imgs, dim=0)\n",
    "                \n",
    "                n_samples = imgs.size(0)\n",
    "                (_, lbls) = torch.meshgrid(torch.arange(0, n_samples), torch.arange(0, 1), indexing=\"xy\")\n",
    "                lbls = lbls.to(dtype=torch.int32).flatten()\n",
    "                \n",
    "                _, embeds = self.cutpaste_model(imgs.to(self.device))\n",
    "                \n",
    "                embeddings.append(embeds.to('cpu'))\n",
    "                labels.append(lbls.to('cpu'))\n",
    "                torch.cuda.empty_cache()\n",
    "                \n",
    "        return torch.cat(embeddings), torch.cat(labels)\n",
    "\n",
    "    @staticmethod\n",
    "    def GDE_fit(train_embeds, save_path=None):\n",
    "        train_embeds_np = train_embeds.detach().cpu().numpy()\n",
    "        GDE = KernelDensity().fit(train_embeds_np)\n",
    "        if save_path:\n",
    "            filename = os.path.join(save_path, 'GDE.sav')\n",
    "            with open(filename, 'wb') as f:\n",
    "                pickle.dump(GDE, f)\n",
    "        return GDE\n",
    "\n",
    "    @staticmethod\n",
    "    def GDE_scores(embeds, GDE):\n",
    "        embeds_np = embeds.detach().cpu().numpy()\n",
    "        scores = GDE.score_samples(embeds_np)\n",
    "        norm = np.linalg.norm(-scores)\n",
    "        # 防止分母为 0 \n",
    "        if norm == 0:\n",
    "            norm = 1e-8\n",
    "        return -scores / norm\n",
    "\n",
    "    def mvtec_anomaly_detection(self, path_to_defect, save_path=None):\n",
    "        defect_name = os.path.split(path_to_defect)[-1]\n",
    "        \n",
    "        # 1. 提取训练集特征并拟合 GDE 密度估计模型\n",
    "        train_images = os.path.join(path_to_defect, 'train')\n",
    "        train_embeds, train_labels = self.create_embeds_tsne(train_images)\n",
    "        GDE_model = self.GDE_fit(train_embeds, save_path)\n",
    "        \n",
    "        # 2. 提取测试集特征并打分\n",
    "        test_images = os.path.join(path_to_defect, 'test')\n",
    "        test_embeds, test_labels = self.create_embeds(test_images)\n",
    "        scores = self.GDE_scores(test_embeds, GDE_model)\n",
    "        \n",
    "        # 3. 计算 AUC 并绘制 ROC\n",
    "        auc_score = self.roc_auc(test_labels.numpy(), scores, defect_name, save_path)\n",
    "        \n",
    "        # 4. 拼合特征并绘制 t-SNE\n",
    "        # 让 train 的 'good' 标签为 0, 切割增强为 2 和 3，以便与 test 区分\n",
    "        train_labels_mod = torch.where(train_labels != 0, train_labels + 1, torch.zeros_like(train_labels))\n",
    "        tsne_labels = torch.cat([test_labels, train_labels_mod])\n",
    "        tsne_embeds = torch.cat([test_embeds, train_embeds])\n",
    "        \n",
    "        self.plot_tsne(tsne_labels, tsne_embeds, defect_name, save_path)\n",
    "        return auc_score\n",
    "\n",
    "if __name__ == '__main__':\n",
    "    args = get_args()\n",
    "    \n",
    "    # Kaggle 检查点检索路径，可以支持多层子目录搜索\n",
    "    all_checkpoints = sorted(pathlib.Path(args.path_to_checkpoints).rglob(\"*.ckpt\"))\n",
    "\n",
    "    for defect in glob(os.path.join(args.Data, '*')):\n",
    "        if not os.path.isdir(defect):\n",
    "            continue\n",
    "            \n",
    "        defect_name = os.path.split(defect)[-1]\n",
    "        \n",
    "        # 寻找匹配当前类别的 checkpoint 权重\n",
    "        checkpoint = [i for i in all_checkpoints if defect_name in str(i)]\n",
    "        if not checkpoint:\n",
    "            print(f\"No checkpoint found for {defect_name}, skipping.\")\n",
    "            continue\n",
    "        else:\n",
    "            checkpoint_path = str(checkpoint[0])\n",
    "\n",
    "        print(f\"Processing category: {defect_name} using weights: {checkpoint_path}\")\n",
    "        anomaly = AnomalyDetection(checkpoint_path, args.batch_size)\n",
    "        save_path = os.path.join(args.save_exp, defect_name)\n",
    "\n",
    "        os.makedirs(save_path, exist_ok=True)\n",
    "        res = anomaly.mvtec_anomaly_detection(defect, save_path)\n",
    "        \n",
    "        print(f'Defect {defect_name}, AUC = {res}, output saved in: {save_path}')\n",
    "        with open(os.path.join(args.save_exp, 'AUC_results.txt'), 'a') as f:\n",
    "            f.write(f'{defect_name} {res} \\n')"
