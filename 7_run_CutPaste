    "##2.改cutpaste.py文件\n",
    "import random\n",
    "import numpy as np\n",
    "from torchvision import transforms\n",
    "from PIL import Image\n",
    "\n",
    "class CutPaste(object):\n",
    "    def __init__(self, transform = True, type = 'binary'):\n",
    "        self.type = type\n",
    "        if transform:\n",
    "            self.transform = transforms.ColorJitter(brightness = 0.1, contrast = 0.1, saturation = 0.1, hue = 0.1)\n",
    "        else:\n",
    "            self.transform = None\n",
    "\n",
    "    @staticmethod\n",
    "    def crop_and_paste_patch(image, patch_w, patch_h, transform, rotation=False):\n",
    "        org_w, org_h = image.size\n",
    "        \n",
    "        # 随机选择裁剪位置\n",
    "        if org_w - patch_w <= 0 or org_h - patch_h <= 0:\n",
    "            return image\n",
    "            \n",
    "        x = random.randint(0, org_w - patch_w)\n",
    "        y = random.randint(0, org_h - patch_h)\n",
    "        patch = image.crop((x, y, x + patch_w, y + patch_h))\n",
    "\n",
    "        if transform is not None:\n",
    "            patch = transform(patch)\n",
    "\n",
    "        if rotation:\n",
    "            # 兼容性修改：确保旋转后的补丁保留 Alpha 通道以便正确粘贴\n",
    "            patch = patch.convert(\"RGBA\").rotate(random.uniform(-45, 45), expand=True)\n",
    "            mask = patch.getchannel('A')\n",
    "            # 重新粘贴回原图位置需要随机\n",
    "            px = random.randint(0, org_w - patch.size[0]) if org_w > patch.size[0] else 0\n",
    "            py = random.randint(0, org_h - patch.size[1]) if org_h > patch.size[1] else 0\n",
    "            image.paste(patch, (px, py), mask)\n",
    "        else:\n",
    "            px = random.randint(0, org_w - patch_w)\n",
    "            py = random.randint(0, org_h - patch_h)\n",
    "            image.paste(patch, (px, py))\n",
    "            \n",
    "        return image.convert(\"RGB\")\n",
    "\n",
    "    def cutpaste(self, image, area_ratio=[0.02, 0.15], aspect_ratio=[0.3, 3.3]):\n",
    "        img_area = image.size[0] * image.size[1]\n",
    "        patch_area = random.uniform(*area_ratio) * img_area\n",
    "        patch_aspect = random.uniform(*aspect_ratio)\n",
    "        patch_w = int(np.sqrt(patch_area * patch_aspect))\n",
    "        patch_h = int(np.sqrt(patch_area / patch_aspect))\n",
    "        return self.crop_and_paste_patch(image.copy(), patch_w, patch_h, self.transform, rotation=False)\n",
    "\n",
    "    def cutpaste_scar(self, image, width=[2, 16], length=[10, 25]):\n",
    "        patch_w, patch_h = random.randint(*width), random.randint(*length)\n",
    "        return self.crop_and_paste_patch(image.copy(), patch_w, patch_h, self.transform, rotation=True)\n",
    "\n",
    "    def __call__(self, image):\n",
    "        if self.type == 'binary':\n",
    "            aug = random.choice([self.cutpaste, self.cutpaste_scar])\n",
    "            return image, aug(image)\n",
    "        else:\n",
    "            return image, self.cutpaste(image), self.cutpaste_scar(image)"
