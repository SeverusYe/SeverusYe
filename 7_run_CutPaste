6:12.219368Z","iopub.status.idle":"2026-03-25T07:26:12.337099Z","shell.execute_reply.started":"2026-03-25T07:26:12.219336Z","shell.execute_reply":"2026-03-25T07:26:12.336022Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"##1.改train.py文件\nimport os\nos.environ[\"KMP_DUPLICATE_LIB_OK\"]=\"TRUE\"\nimport torch\nfrom torch.nn import functional as F\nfrom torchvision import transforms\nimport torch.utils.data\nimport pytorch_lightning as pl\nfrom model import CutPasteNet\nfrom pytorch_lightning import Trainer\nfrom pytorch_lightning.callbacks import ModelCheckpoint\nfrom pytorch_lightning.loggers import TensorBoardLogger\nfrom dataset import MVTecAD\nfrom torch import optim\nfrom pathlib import Path\nimport argparse\n\ndef get_args():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--pretrained', action='store_true', help='use pretrained weight for encoder')\n    parser.add_argument('--dataset_path', help='data to trainset root, eg: \"/kaggle/input/.../bottle\"')\n    parser.add_argument('--dims', default=[512, 512, 512, 512, 512, 512, 512, 512, 128])\n    parser.add_argument('--num_class', type=int, default=3)\n    parser.add_argument('--encoder', default='resnet18')\n    parser.add_argument('--learning_rate', type=float, default=0.03)\n    parser.add_argument('--momentum', type=float, default=0.9)\n    parser.add_argument('--weight_decay', type=float, default=0.00003)\n    parser.add_argument('--num_epochs', type=int, default=300)\n    parser.add_argument('--batch_size', type=int, default=64)\n    parser.add_argument('--num_gpus', type=int, default=1)\n    parser.add_argument('--log_dir', default='./tb_logs')\n    parser.add_argument('--log_dir_name', default='my_model')\n    parser.add_argument('--checkpoint_filename', default='weights')\n    parser.add_argument('--monitor_checkpoint', default='train_loss')\n    parser.add_argument('--monitor_checkpoint_mode', default='min')\n    args = parser.parse_args()\n    return args\n\nclass CutPasteLearner(pl.LightningModule):\n    def __init__(self, encoder=\"resnet18\", pretrained=True, dims=[512, 512, 512, 512, 512, 512, 512, 512, 128], \n                 num_class=3, learning_rate=0.03, momentum=0.9, weight_decay=0.00003, num_epochs=300):\n        super().__init__()\n        # 显式保存所有参数到 self.hparams\n        self.save_hyperparameters()\n        \n        self.model = CutPasteNet(encoder=encoder, pretrained=pretrained, dims=dims, num_class=num_class)\n        self.criterion = torch.nn.CrossEntropyLoss()\n\n    def forward(self, x):\n        return self.model(x)\n\n    def training_step(self, batch, batch_idx):\n        # 这里的 batch 是从数据加载器返回的列表\n        x = torch.cat(batch, axis=0)\n        \n        # 构建标签\n        y = torch.arange(len(batch))\n        y = y.repeat_interleave(len(batch[0])).to(self.device)\n        \n        # 【关键修改】：模型返回的是 (logits, embeds)，这里只需要 logits\n        logits, _ = self(x)\n        \n        loss = self.criterion(logits, y)\n        predicted = torch.argmax(logits, axis=1)\n        \n        # 计算精度\n        accuracy = (predicted == y).float().mean()\n        \n        # 日志记录，适配 Lightning 2.x\n        self.log(\"train_loss\", loss, on_step=True, on_epoch=True, prog_bar=True, batch_size=x.size(0))\n        self.log(\"train_acc\", accuracy, on_step=True, on_epoch=True, prog_bar=True, batch_size=x.size(0))\n        \n        return loss\n\n    def configure_optimizers(self):\n        optimizer = optim.SGD(\n            self.parameters(), \n            lr=self.hparams.learning_rate, \n            momentum=self.hparams.momentum, \n            weight_decay=self.hparams.weight_decay\n        )\n        scheduler = optim.lr_scheduler.CosineAnnealingWarmRestarts(optimizer, T_0=self.hparams.num_epochs)\n        return [optimizer], [scheduler]\n\nif __name__ == \"__main__\":\n    args = get_args()\n    \n    # 设置 Checkpoint 文件名\n    dataset_name = Path(args.dataset_path).stem\n    NAME_CKPT = f\"{args.checkpoint_filename}-{dataset_name}\"\n    \n    logger = TensorBoardLogger(args.log_dir, name=args.log_dir_name)\n    \n    checkpoint_callback = ModelCheckpoint(\n        monitor=args.monitor_checkpoint,\n        dirpath=os.path.join(args.log_dir, args.log_dir_name, f\"version_{logger.version}\", \"checkpoints\"),\n        filename=NAME_CKPT,\n        mode=args.monitor_checkpoint_mode\n    )\n\n    # 实例化模型\n    model = CutPasteLearner(\n        encoder=args.encoder, \n        pretrained=args.pretrained, \n        dims=args.dims, \n        num_class=args.num_class, \n        learning_rate=args.learning_rate, \n        momentum=args.momentum, \n        weight_decay=args.weight_decay,\n        num_epochs=args.num_epochs\n    )\n    \n    # 准备数据集\n    # 注意：确保 args.dataset_path 指向 bottle 这一级，而不是 bottle/train\n    train_data = MVTecAD(args.dataset_path, mode='train')\n    train_loader = torch.utils.data.DataLoader(\n        train_data, \n        batch_size=args.batch_size, \n        shuffle=True, \n        num_workers=2,\n        pin_memory=True\n    )\n\n    # 初始化训练器\n    trainer = pl.Trainer(\n        accelerator=\"gpu\" if args.num_gpus > 0 else \"cpu\",\n        devices=args.num_gpus if args.num_gpus > 0 else \"auto\",\n        logger=logger,\n        callbacks=[checkpoint_callback],\n        max_epochs=args.num_epochs,\n        precision=\"16-mixed\" if args.num_gpus > 0 else 32  # 使用混合精度加速\n    )\n    \n    trainer.fit(model, train_loader)","metadata":{"jupyter":{"source_hidden":true}}},{"cell_type":"markdown","source":"##2.改cutpaste.py文件\nimport random\nimport numpy as np\nfrom torchvision import transforms\nfrom PIL import Image\n\nclass CutPaste(object):\n    def __init__(self, transform = True, type = 'binary'):\n        self.type = type\n        if transform:\n            self.transform = transforms.ColorJitter(brightness = 0.1, contrast = 0.1, saturation = 0.1, hue = 0.1)\n        else:\n            self.transform = None\n\n    @staticmethod\n    def crop_and_paste_patch(image, patch_w, patch_h, transform, rotation=False):\n        org_w, org_h = image.size\n        \n        # 随机选择裁剪位置\n        if org_w - patch_w <= 0 or org_h - patch_h <= 0:\n            return image\n            \n        x = random.randint(0, org_w - patch_w)\n        y = random.randint(0, org_h - patch_h)\n        patch = image.crop((x, y, x + patch_w, y + patch_h))\n\n        if transform is not None:\n            patch = transform(patch)\n\n        if rotation:\n            # 兼容性修改：确保旋转后的补丁保留 Alpha 通道以便正确粘贴\n            patch = patch.convert(\"RGBA\").rotate(random.uniform(-45, 45), expand=True)\n            mask = patch.getchannel('A')\n            # 重新粘贴回原图位置需要随机\n            px = random.randint(0, org_w - patch.size[0]) if org_w > patch.size[0] else 0\n            py = random.randint(0, org_h - patch.size[1]) if org_h > patch.size[1] else 0\n            image.paste(patch, (px, py), mask)\n        else:\n            px = random.randint(0, org_w - patch_w)\n            py = random.randint(0, org_h - patch_h)\n            image.paste(patch, (px, py))\n            \n        return image.convert(\"RGB\")\n\n    def cutpaste(self, image, area_ratio=[0.02, 0.15], aspect_ratio=[0.3, 3.3]):\n        img_area = image.size[0] * image.size[1]\n        patch_area = random.uniform(*area_ratio) * img_area\n        patch_aspect = random.uniform(*aspect_ratio)\n        patch_w = int(np.sqrt(patch_area * patch_aspect))\n        patch_h = int(np.sqrt(patch_area / patch_aspect))\n        return self.crop_and_paste_patch(image.copy(), patch_w, patch_h, self.transform, rotation=False)\n\n    def cutpaste_scar(self, image, width=[2, 16], length=[10, 25]):\n        patch_w, patch_h = random.randint(*width), random.randint(*length)\n        return self.crop_and_paste_patch(image.copy(), patch_w, patch_h, self.transform, rotation=True)\n\n    def __call__(self, image):\n        if self.type == 'binary':\n            aug = random.choice([self.cutpaste, self.cutpaste_scar])\n            return image, aug(image)\n        else:\n            return image, self.cutpaste(image), self.cutpaste_scar(image)","metadata":{"jupyter":{"source_hidden":true}}},{"cell_type":"markdown","source":"##3.改anomaly_detection.py文件\nfrom typing import Any, Dict, Tuple, Union\nfrom sklearn.neighbors import KernelDensity\nfrom sklearn.metrics import roc_curve, auc\nfrom sklearn.preprocessing import normalize\nfrom sklearn.manifold import TSNE\nimport matplotlib.pyplot as plt\nfrom sklearn.utils import shuffle\nfrom model import CutPasteNet\nfrom dataset import MVTecAD\nfrom torch.utils.data import DataLoader\nimport numpy as np\nimport pickle\nimport torch\nimport os\nimport tqdm\nimport argparse\nfrom glob import glob\nimport pathlib\n\ndef get_args():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--path_to_checkpoints',\n                        help='data to the folder where results from self-supervised are saved, eg: ./tb_logs')\n    parser.add_argument('--Data', help='data to MVTec data root.')\n    parser.add_argument('--batch_size', type=int, default=32)\n    # 使用 Kaggle 的输出工作目录\n    parser.add_argument('--save_exp', default='/kaggle/working/anomaly_exp', help='Save fitted models and roc curves')\n    args = parser.parse_args()\n    return args\n\nclass AnomalyDetection:\n    def __init__(self, weights, batch_size, device='cuda' if torch.cuda.is_available() else 'cpu'):\n        '''\n        Anomaly Detection\n\n        args:\n        weights[str] _ path to weights\n        device[str] _ device on which model should be run\n        '''\n        self.cutpaste_model = self.model(device, weights)\n        self.device = device\n        self.batch_size = batch_size\n\n    @staticmethod\n    def model(device, weights):\n        model = CutPasteNet(pretrained=False)\n        state_dict = torch.load(weights, map_location=device)['state_dict']\n        # 移除 Lightning 包装产生的 'model.' 前缀\n        state_dict = {i.replace('model.', ''): j for i, j in state_dict.items()}\n        model.load_state_dict(state_dict)\n        model.to(device)\n        model.eval()\n        return model\n\n    @staticmethod\n    def roc_auc(labels, scores, defect_name=None, save_path=None):\n        fpr, tpr, _ = roc_curve(labels, scores)\n        roc_auc = auc(fpr, tpr)\n\n        plt.figure()\n        plt.title(f'ROC curve: {defect_name}')\n        plt.plot(fpr, tpr, 'b', label='AUC = %0.2f' % roc_auc)\n        plt.legend(loc='lower right')\n        plt.plot([0, 1], [0, 1], 'r--')\n        plt.xlim([0, 1])\n        plt.ylim([0, 1])\n        plt.ylabel('True Positive Rate')\n        plt.xlabel('False Positive Rate')\n\n        save_images = save_path if save_path else './roc_results'\n        os.makedirs(save_images, exist_ok=True)\n        image_path = os.path.join(save_images, f'{defect_name}_roc.jpg' if defect_name else 'roc_curve.jpg')\n        plt.savefig(image_path)\n        plt.close()\n        return roc_auc\n\n    @staticmethod\n    def plot_tsne(labels, embeds, defect_name=None, save_path=None, **kwargs: Dict[str, Any]):\n        \"\"\"t-SNE visualize\"\"\"\n        \n        # 适配 Scikit-Learn：新版本要求降维数据必须是标准的 numpy float 数组\n        embeds_np = embeds.detach().cpu().numpy().astype(np.float32)\n        labels_np = labels.detach().cpu().numpy().astype(np.int32)\n\n        tsne = TSNE(\n            n_components=2, \n            verbose=0, \n            n_iter=kwargs.get(\"n_iter\", 1000),\n            learning_rate=kwargs.get(\"learning_rate\", 'auto'), # 新版 sklearn 'auto' 是更好的默认值\n            perplexity=kwargs.get(\"perplexity\", 30), \n            early_exaggeration=kwargs.get(\"early_exaggeration\", 12),\n            angle=kwargs.get(\"angle\", 0.5),\n            init=kwargs.get(\"init\", \"pca\"),\n        )\n        \n        embeds_np, labels_np = shuffle(embeds_np, labels_np)\n        tsne_results = tsne.fit_transform(embeds_np)\n\n        # 适配 Matplotlib 3.x：旧版 plt.cm.get_cmap 已经被废弃\n        try:\n            cmap = plt.colormaps['spring']\n        except (AttributeError, KeyError):\n            cmap = plt.cm.get_cmap(\"spring\")\n\n        colors = np.vstack((np.array([[0.0, 1.0, 0.0, 1.0]]), cmap(np.linspace(0, 1, 3))))\n        legends = [\"good\", \"anomaly\", \"cutpaste\", \"cutpaste-scar\"]\n        \n        fig, ax = plt.subplots(1)\n        plt.title(f't-SNE: {defect_name}')\n        \n        unique_labels = np.unique(labels_np)\n        for label in unique_labels:\n            indices = np.where(labels_np == label)\n            res = tsne_results[indices]\n            if len(res) > 0:\n                ax.plot(*res.T, marker=\"*\", linestyle=\"\", ms=5, \n                        label=legends[label] if label < len(legends) else f\"label_{label}\", \n                        color=colors[label] if label < len(colors) else 'black')\n        \n        ax.legend(loc=\"best\")\n        plt.xticks([])\n        plt.yticks([])\n\n        save_images = save_path if save_path else './tsne_results'\n        os.makedirs(save_images, exist_ok=True)\n        image_path = os.path.join(save_images, f'{defect_name}_tsne.jpg' if defect_name else 'tsne.jpg')\n        plt.savefig(image_path)\n        plt.close()\n\n    def create_embeds(self, path_to_images):\n        embeddings = []\n        labels = []\n        dataset = MVTecAD(path_to_images, mode='test')\n        dataloader = DataLoader(dataset, batch_size=self.batch_size, num_workers=2)\n        \n        with torch.no_grad():\n            for imgs, lbls in dataloader:\n                logits, embeds = self.cutpaste_model(imgs.to(self.device))\n                del logits\n                embeddings.append(embeds.to('cpu'))\n                labels.append(lbls.to('cpu'))\n                torch.cuda.empty_cache()\n\n        return torch.cat(embeddings), torch.cat(labels)\n    \n    def create_embeds_tsne(self, path_to_images: Union[str, pathlib.Path]) -> Tuple[torch.Tensor, torch.Tensor]:\n        embeddings = []\n        labels = []\n        dataset = MVTecAD(path_to_images, mode='train')\n        dataloader = DataLoader(dataset, batch_size=self.batch_size, num_workers=2)\n        \n        with torch.no_grad():\n            for (i_batch, imgs) in enumerate(dataloader):\n                # 兼容性整理\n                if isinstance(imgs, list):\n                    imgs = torch.cat(imgs, dim=0)\n                \n                n_samples = imgs.size(0)\n                (_, lbls) = torch.meshgrid(torch.arange(0, n_samples), torch.arange(0, 1), indexing=\"xy\")\n                lbls = lbls.to(dtype=torch.int32).flatten()\n                \n                _, embeds = self.cutpaste_model(imgs.to(self.device))\n                \n                embeddings.append(embeds.to('cpu'))\n                labels.append(lbls.to('cpu'))\n                torch.cuda.empty_cache()\n                \n        return torch.cat(embeddings), torch.cat(labels)\n\n    @staticmethod\n    def GDE_fit(train_embeds, save_path=None):\n        train_embeds_np = train_embeds.detach().cpu().numpy()\n        GDE = KernelDensity().fit(train_embeds_np)\n        if save_path:\n            filename = os.path.join(save_path, 'GDE.sav')\n            with open(filename, 'wb') as f:\n                pickle.dump(GDE, f)\n        return GDE\n\n    @staticmethod\n    def GDE_scores(embeds, GDE):\n        embeds_np = embeds.detach().cpu().numpy()\n        scores = GDE.score_samples(embeds_np)\n        norm = np.linalg.norm(-scores)\n        # 防止分母为 0 \n        if norm == 0:\n            norm = 1e-8\n        return -scores / norm\n\n    def mvtec_anomaly_detection(self, path_to_defect, save_path=None):\n        defect_name = os.path.split(path_to_defect)[-1]\n        \n        # 1. 提取训练集特征并拟合 GDE 密度估计模型\n        train_images = os.path.join(path_to_defect, 'train')\n        train_embeds, train_labels = self.create_embeds_tsne(train_images)\n        GDE_model = self.GDE_fit(train_embeds, save_path)\n        \n        # 2. 提取测试集特征并打分\n        test_images = os.path.join(path_to_defect, 'test')\n        test_embeds, test_labels = self.create_embeds(test_images)\n        scores = self.GDE_scores(test_embeds, GDE_model)\n        \n        # 3. 计算 AUC 并绘制 ROC\n        auc_score = self.roc_auc(test_labels.numpy(), scores, defect_name, save_path)\n        \n        # 4. 拼合特征并绘制 t-SNE\n        # 让 train 的 'good' 标签为 0, 切割增强为 2 和 3，以便与 test 区分\n        train_labels_mod = torch.where(train_labels != 0, train_labels + 1, torch.zeros_like(train_labels))\n        tsne_labels = torch.cat([test_labels, train_labels_mod])\n        tsne_embeds = torch.cat([test_embeds, train_embeds])\n        \n        self.plot_tsne(tsne_labels, tsne_embeds, defect_name, save_path)\n        return auc_score\n\nif __name__ == '__main__':\n    args = get_args()\n    \n    # Kaggle 检查点检索路径，可以支持多层子目录搜索\n    all_checkpoints = sorted(pathlib.Path(args.path_to_checkpoints).rglob(\"*.ckpt\"))\n\n    for defect in glob(os.path.join(args.Data, '*')):\n        if not os.path.isdir(defect):\n            continue\n            \n        defect_name = os.path.split(defect)[-1]\n        \n        # 寻找匹配当前类别的 checkpoint 权重\n        checkpoint = [i for i in all_checkpoints if defect_name in str(i)]\n        if not checkpoint:\n            print(f\"No checkpoint found for {defect_name}, skipping.\")\n            continue\n        else:\n            checkpoint_path = str(checkpoint[0])\n\n        print(f\"Processing category: {defect_name} using weights: {checkpoint_path}\")\n        anomaly = AnomalyDetection(checkpoint_path, args.batch_size)\n        save_path = os.path.join(args.save_exp, defect_name)\n\n        os.makedirs(save_path, exist_ok=True)\n        res = anomaly.mvtec_anomaly_detection(defect, save_path)\n        \n        print(f'Defect {defect_name}, AUC = {res}, output saved in: {save_path}')\n        with open(os.path.join(args.save_exp, 'AUC_results.txt'), 'a') as f:\n            f.write(f'{defect_name} {res} \\n')","metadata":{"jupyter":{"source_hidden":true}}}]}