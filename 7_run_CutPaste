    "##1.改train.py文件\n",
    "import os\n",
    "os.environ[\"KMP_DUPLICATE_LIB_OK\"]=\"TRUE\"\n",
    "import torch\n",
    "from torch.nn import functional as F\n",
    "from torchvision import transforms\n",
    "import torch.utils.data\n",
    "import pytorch_lightning as pl\n",
    "from model import CutPasteNet\n",
    "from pytorch_lightning import Trainer\n",
    "from pytorch_lightning.callbacks import ModelCheckpoint\n",
    "from pytorch_lightning.loggers import TensorBoardLogger\n",
    "from dataset import MVTecAD\n",
    "from torch import optim\n",
    "from pathlib import Path\n",
    "import argparse\n",
    "\n",
    "def get_args():\n",
    "    parser = argparse.ArgumentParser()\n",
    "    parser.add_argument('--pretrained', action='store_true', help='use pretrained weight for encoder')\n",
    "    parser.add_argument('--dataset_path', help='data to trainset root, eg: \"/kaggle/input/.../bottle\"')\n",
    "    parser.add_argument('--dims', default=[512, 512, 512, 512, 512, 512, 512, 512, 128])\n",
    "    parser.add_argument('--num_class', type=int, default=3)\n",
    "    parser.add_argument('--encoder', default='resnet18')\n",
    "    parser.add_argument('--learning_rate', type=float, default=0.03)\n",
    "    parser.add_argument('--momentum', type=float, default=0.9)\n",
    "    parser.add_argument('--weight_decay', type=float, default=0.00003)\n",
    "    parser.add_argument('--num_epochs', type=int, default=300)\n",
    "    parser.add_argument('--batch_size', type=int, default=64)\n",
    "    parser.add_argument('--num_gpus', type=int, default=1)\n",
    "    parser.add_argument('--log_dir', default='./tb_logs')\n",
    "    parser.add_argument('--log_dir_name', default='my_model')\n",
    "    parser.add_argument('--checkpoint_filename', default='weights')\n",
    "    parser.add_argument('--monitor_checkpoint', default='train_loss')\n",
    "    parser.add_argument('--monitor_checkpoint_mode', default='min')\n",
    "    args = parser.parse_args()\n",
    "    return args\n",
    "\n",
    "class CutPasteLearner(pl.LightningModule):\n",
    "    def __init__(self, encoder=\"resnet18\", pretrained=True, dims=[512, 512, 512, 512, 512, 512, 512, 512, 128], \n",
    "                 num_class=3, learning_rate=0.03, momentum=0.9, weight_decay=0.00003, num_epochs=300):\n",
    "        super().__init__()\n",
    "        # 显式保存所有参数到 self.hparams\n",
    "        self.save_hyperparameters()\n",
    "        \n",
    "        self.model = CutPasteNet(encoder=encoder, pretrained=pretrained, dims=dims, num_class=num_class)\n",
    "        self.criterion = torch.nn.CrossEntropyLoss()\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.model(x)\n",
    "\n",
    "    def training_step(self, batch, batch_idx):\n",
    "        # 这里的 batch 是从数据加载器返回的列表\n",
    "        x = torch.cat(batch, axis=0)\n",
    "        \n",
    "        # 构建标签\n",
    "        y = torch.arange(len(batch))\n",
    "        y = y.repeat_interleave(len(batch[0])).to(self.device)\n",
    "        \n",
    "        # 【关键修改】：模型返回的是 (logits, embeds)，这里只需要 logits\n",
    "        logits, _ = self(x)\n",
    "        \n",
    "        loss = self.criterion(logits, y)\n",
    "        predicted = torch.argmax(logits, axis=1)\n",
    "        \n",
    "        # 计算精度\n",
    "        accuracy = (predicted == y).float().mean()\n",
    "        \n",
    "        # 日志记录，适配 Lightning 2.x\n",
    "        self.log(\"train_loss\", loss, on_step=True, on_epoch=True, prog_bar=True, batch_size=x.size(0))\n",
    "        self.log(\"train_acc\", accuracy, on_step=True, on_epoch=True, prog_bar=True, batch_size=x.size(0))\n",
    "        \n",
    "        return loss\n",
    "\n",
    "    def configure_optimizers(self):\n",
    "        optimizer = optim.SGD(\n",
    "            self.parameters(), \n",
    "            lr=self.hparams.learning_rate, \n",
    "            momentum=self.hparams.momentum, \n",
    "            weight_decay=self.hparams.weight_decay\n",
    "        )\n",
    "        scheduler = optim.lr_scheduler.CosineAnnealingWarmRestarts(optimizer, T_0=self.hparams.num_epochs)\n",
    "        return [optimizer], [scheduler]\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    args = get_args()\n",
    "    \n",
    "    # 设置 Checkpoint 文件名\n",
    "    dataset_name = Path(args.dataset_path).stem\n",
    "    NAME_CKPT = f\"{args.checkpoint_filename}-{dataset_name}\"\n",
    "    \n",
    "    logger = TensorBoardLogger(args.log_dir, name=args.log_dir_name)\n",
    "    \n",
    "    checkpoint_callback = ModelCheckpoint(\n",
    "        monitor=args.monitor_checkpoint,\n",
    "        dirpath=os.path.join(args.log_dir, args.log_dir_name, f\"version_{logger.version}\", \"checkpoints\"),\n",
    "        filename=NAME_CKPT,\n",
    "        mode=args.monitor_checkpoint_mode\n",
    "    )\n",
    "\n",
    "    # 实例化模型\n",
    "    model = CutPasteLearner(\n",
    "        encoder=args.encoder, \n",
    "        pretrained=args.pretrained, \n",
    "        dims=args.dims, \n",
    "        num_class=args.num_class, \n",
    "        learning_rate=args.learning_rate, \n",
    "        momentum=args.momentum, \n",
    "        weight_decay=args.weight_decay,\n",
    "        num_epochs=args.num_epochs\n",
    "    )\n",
    "    \n",
    "    # 准备数据集\n",
    "    # 注意：确保 args.dataset_path 指向 bottle 这一级，而不是 bottle/train\n",
    "    train_data = MVTecAD(args.dataset_path, mode='train')\n",
    "    train_loader = torch.utils.data.DataLoader(\n",
    "        train_data, \n",
    "        batch_size=args.batch_size, \n",
    "        shuffle=True, \n",
    "        num_workers=2,\n",
    "        pin_memory=True\n",
    "    )\n",
    "\n",
    "    # 初始化训练器\n",
    "    trainer = pl.Trainer(\n",
    "        accelerator=\"gpu\" if args.num_gpus > 0 else \"cpu\",\n",
    "        devices=args.num_gpus if args.num_gpus > 0 else \"auto\",\n",
    "        logger=logger,\n",
    "        callbacks=[checkpoint_callback],\n",
    "        max_epochs=args.num_epochs,\n",
    "        precision=\"16-mixed\" if args.num_gpus > 0 else 32  # 使用混合精度加速\n",
    "    )\n",
    "    \n",
    "    trainer.fit(model, train_loader)"
